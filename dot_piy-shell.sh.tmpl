# ~/.piy-shell.sh — written by chezmoi from piy-genie. Do not edit; edit the kit and
# run `piy update`. Their .zshrc/.bashrc holds ONE line that sources this file.
#
# WHY IT IS A SEPARATE FILE. v1 fenced a block inside ~/.zshrc with markers and told the
# agent to replace between them. Appending twice instead left two `alias ccc=` pairs, and
# the instruction for changing your mind — move the `#` — then edited the first pair while
# the second silently won. They asked for the safe option and got the dangerous one. A file
# chezmoi owns cannot be appended to twice: there is one file and it has one content.

# The Claude Code installer writes here and touches no startup file at all — it just prints
# a note telling you to fix PATH yourself. Without this line `ccc` works in a login shell
# and is `command not found` in every other one.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="$HOME/.local/share/mise/shims:$PATH" ;;
esac
# chezmoi places `piy` at ~/bin/piy, and ~/bin is NOT on PATH by default anywhere that
# matters: macOS builds PATH from /etc/paths via path_helper and never adds it; on Ubuntu
# only ~/.profile does, and only for a login shell. Without this line the very first thing
# the person is told to run — `piy add` — is `command not found`.
case ":$PATH:" in
  *":$HOME/bin:"*) ;;
  *) PATH="$HOME/bin:$PATH" ;;
esac
export PATH

# There is no `ccc` any more (2026-09-17). They type `claude`. How it asks — or does not — is
# `permissions.defaultMode` in ~/.claude/settings.json, set to "auto" by the kit and theirs
# to change. An alias that carried a flag was one more thing to explain, and one more place
# for two definitions to disagree.

# ── their page: http://127.0.0.1:29200/ ───────────────────────────────────────────────
# A file server over ~/piy-work — the pages the agent writes for them, one folder per
# project, README.md rendered at every folder (the root one is the howto). Started here,
# from the first interactive shell after a boot, so it needs no launchd, no systemd, and
# behaves identically on macOS and WSL. A Windows browser reaches it on localhost by
# default (WSL2 NAT mode, documented). Loopback only and symlinks off: the served root is
# only what was written to be read, so it carries no password — anything else of theirs
# stays outside it.
#
# The guard asks whether THEIR PAGE is answering, not whether a process called miniserve
# exists. `pgrep -x miniserve` matched any miniserve at all — and miniserve is a globally
# installed tool on their machine now, which the agent is told to use for showing folders.
# One unrelated server on another port silently suppressed their page in every new shell,
# with nothing on screen and nothing in the log (reproduced 2026-09-18). curl is a hard
# dependency of the whole kit (install.sh is fetched with it), so this costs nothing new;
# exit 0 means something answered on 29200, and connection-refused means start it.
# Flags are from `miniserve 0.35.0 --help`, not memory (-q there is a QR code, not quiet).
# `! -L`: miniserve with -P refuses a symlinked ROOT and exits at once (measured), so a
# symlinked ~/piy-work would have respawned a doomed process from every new shell, with
# every message going to /dev/null. Its output goes to a log now, so "the page will not
# open" has somewhere to look: ~/.piy-server.log.
if [ -d "$HOME/piy-work" ] && [ ! -L "$HOME/piy-work" ] && command -v miniserve >/dev/null 2>&1 \
   && ! curl -s -o /dev/null --max-time 1 http://127.0.0.1:29200/ 2>/dev/null; then
  ( nohup miniserve -i 127.0.0.1 -p 29200 -P --readme -t "Your page" "$HOME/piy-work" \
      >>"$HOME/.piy-server.log" 2>&1 & )
fi


if [ -n "${ZSH_VERSION:-}" ]; then
  autoload -Uz compinit 2>/dev/null && compinit -u 2>/dev/null
  zstyle ':completion:*' menu select
  zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive TAB
  setopt AUTO_CD 2>/dev/null || true
  unsetopt BEEP 2>/dev/null || true
fi

# ── The prompt, and colour ────────────────────────────────────────────────────────────
# A terminal that is all one grey is where a beginner loses their place. This is the
# smallest prompt that answers the three questions people actually ask: where am I, is
# this a project with history, and have I saved?
#
# Prompt It Yourself red is #e2342b. zsh takes it literally on a truecolor terminal; everything
# else gets xterm-256 colour 203, which is the nearest red. Both are set, so no terminal
# ends up with a raw escape sequence in the prompt.
#
# The `*` is the one to explain out loud: it means there is work here you have not saved.
# `/piy-save` clears it. It is referenced by that skill and by the page they keep, so if
# this ever moves, those move with it.

if [ -n "${ZSH_VERSION:-}" ]; then
  autoload -Uz vcs_info 2>/dev/null
  zstyle ':vcs_info:git:*' formats       ' %F{242}%b%f%F{203}%u%c%f'
  zstyle ':vcs_info:git:*' actionformats ' %F{242}%b|%a%f'
  zstyle ':vcs_info:git:*' unstagedstr '*'
  zstyle ':vcs_info:git:*' stagedstr   '*'
  zstyle ':vcs_info:git:*' check-for-changes true
  precmd_functions+=(vcs_info)
  setopt PROMPT_SUBST
  PROMPT='%F{203}%1~%f${vcs_info_msg_0_} %F{203}›%f '

elif [ -n "${BASH_VERSION:-}" ]; then
  # bash has no vcs_info, so this is the same three facts by hand. Kept quiet and cheap:
  # every failure path prints nothing rather than an error into the prompt.
  __piy_git() {
    b=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || return 0
    d=''; git diff --quiet --ignore-submodules HEAD 2>/dev/null || d='*'
    printf ' \001\033[2m\002%s\001\033[0m\033[38;5;203m\002%s\001\033[0m\002' "$b" "$d"
  }
  PS1='\[\033[38;5;203m\]\W\[\033[0m\]$(__piy_git) \[\033[38;5;203m\]›\[\033[0m\] '
fi

# Colour everywhere else too. macOS ls wants -G and its own variable; GNU ls wants
# --color, and asking the wrong one produces an error on every single command.
if ls --color=auto >/dev/null 2>&1; then
  alias ls='ls --color=auto'
else
  export CLICOLOR=1
  export LSCOLORS=ExGxFxdaCxDaDahbadeche
fi
alias grep='grep --color=auto'
export LESS='-R'
